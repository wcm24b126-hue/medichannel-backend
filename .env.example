# Use the Neon development branch's direct (non-pooler) connection host.
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require
DB_USERNAME=YOUR_NEON_ROLE
DB_PASSWORD=SET_LOCALLY

# Generate three distinct Base64 values with: openssl rand -base64 32
JWT_SECRET=SET_LOCALLY
ENCRYPTION_KEY=SET_LOCALLY
HMAC_SECRET=SET_LOCALLY

# Local frontend origin. Set the deployed Netlify site origin on Render.
APP_FRONTEND_ORIGIN=http://localhost:3000
SPRING_PROFILES_ACTIVE=dev
